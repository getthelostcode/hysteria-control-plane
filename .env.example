APP_NAME="Hysteria Control Plane"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8088

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=hysteria_cp

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DB_HOST=127.0.0.1
DB_PORT=3399
DB_DATABASE=hysteria_cp
DB_USERNAME=root
DB_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=2
HORIZON_PREFIX=horizon:cp
REVERB_APP_ID=hysteria-cp
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081
VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
VITE_REVERB_HOST=${REVERB_HOST}
VITE_REVERB_PORT=${REVERB_PORT}
VITE_REVERB_SCHEME=${REVERB_SCHEME}
AGENT_SIGNATURE_TTL=300
HYSTERIA_NODE_DOMAIN=example.com
AGENT_SIGNATURE_TTL=300
AGENT_DEFAULT_HEARTBEAT=30
AGENT_OFFLINE_THRESHOLD=90
HYSTERIA_NODE_DOMAIN=example.com
HYSTERIA_CONFIG_TEMPLATE_JSON=null
METRICS_RETENTION_DAYS=30

# 部署在反向代理/隧道（Cloudflare Tunnel、nginx、ALB）后面时必须配置：
# 否则 $request->ip() 返回代理自己的地址（同机 cloudflared → 127.0.0.1），
# 节点 IP 列与审计日志的 IP 都变成 127.0.0.1。多跳代理填上游网段列表；只在应用
# 无法被直连时才用 '*'。
TRUSTED_PROXIES=127.0.0.1,::1
